{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owners reference (target-defined)",
  "type": "object",
  "required": ["subject_areas", "unknown"],
  "properties": {
    "subject_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "archetype", "product_owners"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "archetype": { "enum": ["data", "process"] },
          "product_owners": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "email" } }
        }
      }
    },
    "unknown": {
      "type": "object",
      "required": ["product_owners"],
      "properties": { "product_owners": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    }
  }
}
