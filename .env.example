# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Development only. In the hosted deployment these resolve from a secrets store
# at call time and never appear in a file, config, or log.

# --- LLM gateway (required) ------------------------------------------------
# All model traffic routes through the LiteLLM gateway. Never call a
# provider directly.
LITELLM_API_BASE=https://litellm.example.com
LITELLM_API_KEY=
# Approved model name. Also serves as the bearer token for Anthropic-style
# clients, so a separate ANTHROPIC_API_KEY is not needed.
LITELLM_MODEL=claude-sonnet-4-5-20250929
ACT_CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Point Anthropic-protocol clients at the gateway, or at a local strip-proxy
# when one is needed to drop unsupported request parameters.
ANTHROPIC_BASE_URL=http://127.0.0.1:8787

# --- Git host (required for publish) ---------------------------------------
# Used by the conductor only. Nested author/verifier sub-agents still have no
# git credential of their own; the conductor session is the one that commits,
# pushes, opens the PR, and files issues (publish path vs publisher mode).
GITHUB_TOKEN=

# --- Local dev only (optional) ---------------------------------------------
# Personal Claude Code auth instead of a gateway key (see README):
# CLAUDE_AUTH_MODE=local-claude
