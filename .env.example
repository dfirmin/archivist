# Copy to .env and fill in. .env is gitignored and must never be committed.
# Development only: in a hosted deployment these resolve from a secrets store.

# --- How Claude Code authenticates ------------------------------------------
# gateway-key   (default) a LiteLLM / Anthropic-compatible gateway
# anthropic-api the Anthropic API directly (api.anthropic.com)
# local-claude  your own Claude Code login via a mounted apiKeyHelper (local dev)
# inherit       whatever Claude Code is already signed in to (e.g. CLAUDE_CODE_OAUTH_TOKEN)
CLAUDE_AUTH_MODE=gateway-key

# Default model for sessions. Each agent also pins its own model in agents/*.md.
ACT_CLAUDE_MODEL=claude-sonnet-5-5

# --- anthropic-api ------------------------------------------------------------
# Your Anthropic API key. In this mode any gateway URL or token below is ignored.
ANTHROPIC_API_KEY=

# --- gateway-key --------------------------------------------------------------
LITELLM_API_BASE=https://litellm.example.com
LITELLM_API_KEY=
LITELLM_MODEL=claude-sonnet-5-5
# Optional: point Claude Code at a local proxy in front of the gateway instead.
# ANTHROPIC_BASE_URL=http://127.0.0.1:8787

# --- Engine versions ------------------------------------------------------------
# Targets pin the engine release they run on (`engine:` in contracts/target.yaml). A run on a
# different engine fetches that release from here, once, into ARCHIVIST_ENGINE_CACHE.
# ARCHIVIST_ENGINE_REPO=https://github.com/dfirmin/archivist
# ARCHIVIST_ENGINE_CACHE=~/.cache/archivist/engines

# --- Git host (required for publishing) -------------------------------------
# Used by the conductor only; sub-agents never touch git. A mounted `gh` login also works.
# The token must be allowed to write workflow files (classic PAT: the `workflow` scope; fine-grained
# token or app: Workflows read and write), because the scaffold seeds .github/workflows/.
# It must also open pull requests (classic PAT: `repo`; fine-grained: Pull requests read and write):
# without that the onboarding branch is pushed but the PR is not, and the run fails saying so.
GITHUB_TOKEN=
