{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archivist/contracts/gap-kinds.schema.json",
  "title": "Gap kinds",
  "description": "Every gap the gap-agent fleet judges: which concept types it applies to, the evidence, the binding detection list and the priority.",
  "type": "object",
  "required": ["version", "kinds"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "origins": {
      "type": "object",
      "description": "Origin id -> meaning. Default: author and documentation.",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
      "description": "Allowed priority values, lowest first. Default: low, medium, high."
    },
    "kinds": { "type": "array", "items": { "$ref": "#/$defs/kind" } },
    "guidance": { "type": "string" }
  },
  "$defs": {
    "kind": {
      "type": "object",
      "required": ["id", "applies_to", "definition", "origins", "context", "detection", "priority"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Concept type ids."
        },
        "definition": { "type": "string", "minLength": 1 },
        "origins": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "fixed_origin": { "type": "string" },
        "context": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "detection": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "uses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "Reference contract names the gap-agent consults for this kind."
        },
        "priority": { "type": "string" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
