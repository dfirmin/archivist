{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archivist/contracts/structure.schema.json",
  "title": "Document structure",
  "description": "One file per structure under the structures directory. Sections are ## headings; subsections nest one level deeper. Each section names its owner.",
  "type": "object",
  "required": ["id", "description", "sections"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1 },
    "sections": { "$ref": "#/$defs/sections" },
    "guidance": { "type": "string" }
  },
  "$defs": {
    "sections": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/section" }
        ]
      }
    },
    "section": {
      "type": "object",
      "required": ["heading"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "required": { "type": "boolean", "description": "Default true." },
        "owner": {
          "enum": ["author", "enricher", "placeholder"],
          "description": "Who writes the body. Default author. placeholder: the heading plus `placeholder` text, filled later by people or another role."
        },
        "placeholder": { "type": "string", "minLength": 1 },
        "enrich": { "$ref": "#/$defs/enrich" },
        "subsections": { "$ref": "#/$defs/sections" }
      }
    },
    "enrich": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "minLength": 1, "description": "An engine enrichment method from agents/profile.yaml." },
        "input_field": { "type": "string", "description": "The frontmatter field that lists what to enrich from." },
        "lookup": { "type": "string", "description": "A reference contract name used to resolve inputs (e.g. repos)." },
        "fallback_field": { "type": "string" },
        "guidance": { "type": "string" }
      }
    }
  }
}
